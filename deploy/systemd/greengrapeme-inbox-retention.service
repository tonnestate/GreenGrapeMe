[Unit]
Description=GreenGrapeMe public inquiry PII retention scrub
After=local-fs.target

[Service]
Type=oneshot
User=gg-public
Group=gg-public
WorkingDirectory=/opt/greengrapeme
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/greengrapeme/public-retention.env
UMask=0077
ExecStart=/opt/greengrapeme/.venv/bin/python -m greengrapeme.cli --db ${GG_PUBLIC_INBOX_DB} --tenant ${GG_PUBLIC_INQUIRY_TENANT} public-inbox-purge --max-age-days 30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/greengrapeme/public

[Install]
WantedBy=multi-user.target
